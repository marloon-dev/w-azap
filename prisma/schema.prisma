// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  OWNER
  STAFF
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  STICKER
  LOCATION
  CONTACT
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  role      Role     @default(OWNER)
  apiKey    String?  @unique // SHA-256 hash of the API key (the key itself is shown only once)
  apiKeyHint String?          // First characters of the key, for display ("wag_ab12…")
  sessionVersion Int @default(0) // Bump to invalidate all of the user's logins (password/role change)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  sessions  Session[]
  webhooks  Webhook[]
  notifications Notification[]
  sessionAccesses SessionAccess[]
}

model Session {
  id          String    @id @default(cuid())
  userId      String
  name        String    // e.g. "Marketing WA"
  sessionId   String    @unique // The unique ID used for Baileys auth
  status      String    @default("DISCONNECTED") // CONNECTED, DISCONNECTED, ZOMBIE
  qr          String?   @db.Text
  config      Json?     // Store instance specific config (e.g. "read_receipts": true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contacts    Contact[]
  messages    Message[]
  groups      Group[]
  autoReplies AutoReply[]
  stories     Story[]
  scheduledMessages ScheduledMessage[]
  webhooks    Webhook[]
  botConfig   BotConfig?
  emailForward EmailForward?
  sessionAccesses SessionAccess[]
  agendaConfig  AgendaConfig?
  agendaServices AgendaService[]
  agendaProfessionals AgendaProfessional[]
  agendaBlocks  AgendaBlock[]
  agendaAppointments AgendaAppointment[]
  agendaConversations AgendaConversation[]
}

model Contact {
  id          String   @id @default(cuid())
  sessionId   String
  jid         String   // remoteJid (123456@s.whatsapp.net)
  lid         String?  // LID JID
  name        String?
  notify      String?  // Pushname
  verifiedName String? // Business Name
  remoteJidAlt String? // Alternate JID (e.g. Phone if JID is LID)
  profilePic  String?  @db.Text
  data        Json?    // Detailed contact data
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  messages    Message[]

  @@unique([sessionId, jid])
}

model Message {
  id          String        @id @default(cuid())
  sessionId   String
  remoteJid   String        // Receiver or Group Jid
  senderJid   String?       // If group, who sent it. If private, same as remoteJid (incoming) or me (outgoing)
  fromMe      Boolean
  keyId       String        // WhatsApp Message Key ID
  pushName    String?
  type        MessageType   @default(TEXT)
  content     String?       @db.Text // Text content or Caption
  mediaUrl    String?       @db.Text // Path to file if media
  status      MessageStatus @default(PENDING)
  timestamp   DateTime      @default(now())
  
  quoteId     String?       // For replies
  
  contactId   String?
  contract    Contact?      @relation(fields: [contactId], references: [id])
  session     Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, keyId])
  @@index([sessionId, remoteJid])
  @@index([sessionId, remoteJid, timestamp])
}

model Group {
  id          String   @id @default(cuid())
  sessionId   String
  jid         String
  subject     String?
  description String?  @db.Text
  ownerJid    String?
  participants Json?   // Stored as JSON for now: [{id: '123@s.whatsapp.net', admin: 'admin' | null}]
  creation    DateTime?
  restrict    Boolean? // Only admins can edit group info
  announce    Boolean? // Only admins can send messages
  
  metadata    Json?    // Raw full metadata dump
  
  inviteCode  String?
  
  // Community Features
  isCommunity Boolean  @default(false)
  linkedParentJid String? // JID of the community parent group if it belongs to one
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, jid])
}

model AutoReply {
  id          String   @id @default(cuid())
  sessionId   String
  keyword     String
  matchType   String   // EXACT, CONTAINS, REGEX
  response    String?  @db.Text
  isMedia     Boolean  @default(false)
  mediaUrl    String?
  mediaType   String?
  triggerType String   @default("ALL") // ALL, GROUP, PRIVATE
  createdAt   DateTime @default(now())

  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model Story {
  id          String   @id @default(cuid())
  sessionId   String
  jid         String   // User who posted the story or Broadcast JID
  content     String?  @db.Text
  mediaUrl    String?  @db.Text
  type        String   // IMAGE, VIDEO, TEXT
  timestamp   DateTime @default(now())
  viewed      Boolean  @default(false)

  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model ScheduledMessage {
  id          String   @id @default(cuid())
  sessionId   String
  jid         String
  content     String?  @db.Text
  mediaUrl    String?
  mediaType   String?  // image, video, document, etc.
  sendAt      DateTime
  cronExpression String? // e.g., '*/5 * * * *'
  recurrenceRule String? @db.Text // UI JSON state
  status      String   @default("PENDING") // PENDING, SENT, FAILED
  createdAt   DateTime @default(now())

  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

// Store for Baileys MultiFileAuthState (in DB)
model AuthState {
  id        String   @id @default(cuid())
  sessionId String
  key       String   // Filename/Key (creds.json, etc)
  value     Json
  
  @@unique([sessionId, key])
}

// Webhook configuration for external event notifications
model Webhook {
  id          String   @id @default(cuid())
  userId      String
  sessionId   String?  // Optional: specific session, null = all sessions
  name        String   // e.g. "My Server Webhook"
  url         String   // The webhook endpoint URL
  secret      String?  // Optional secret for HMAC signing
  events      Json     // Array of event types: ["message.received", "message.sent", "connection.update", etc.]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  session     Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  logs        WebhookLog[]
}

// Webhook delivery logs — tracks every webhook request attempt
model WebhookLog {
  id                 String   @id @default(cuid())
  webhookId          String
  event              String   // The event that triggered this webhook
  status             String   // SUCCESS, FAILED
  requestUrl         String   @db.Text
  requestHeaders     Json?
  requestBody        Json?
  responseStatusCode Int?
  responseBody       String?  @db.Text
  responseTimeMs     Int?
  errorMessage       String?  @db.Text
  createdAt          DateTime @default(now())

  webhook            Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([webhookId, createdAt])
}

enum AccessMode {
  ALL
  OWNER
  SPECIFIC
  BLACKLIST
}

model BotConfig {
  id            String   @id @default(cuid())
  sessionId     String   @unique
  enabled       Boolean  @default(true)
  
  // Bot Command Access
  botName       String   @default("W-AZAP Bot")
  botMode       AccessMode @default(OWNER)
  botAllowedJids Json?     // Array of JIDs ["628123@s.whatsapp.net"]
  botBlockedJids Json?     // Array of JIDs ["628123@s.whatsapp.net"] for BLACKLIST mode

  // Auto Reply Access
  autoReplyMode AccessMode @default(ALL)
  autoReplyAllowedJids Json?
  autoReplyBlockedJids Json? // Array of JIDs for BLACKLIST mode

  enableSticker Boolean  @default(true)
  enableVideoSticker Boolean @default(true)
  maxStickerDuration Int @default(10) // in seconds
  enablePing    Boolean  @default(true)
  enableUptime  Boolean  @default(true)
  removeBgApiKey String?
  prefix        String   @default("#")
  
  // Anti-Spam / Rate Limit
  antiSpamEnabled Boolean @default(false)
  spamLimit       Int     @default(5)    // Messages allowed in window
  spamInterval    Int     @default(10)   // Seconds window
  spamDelayMin    Int     @default(1000) // MS min delay
  spamDelayMax    Int     @default(3000) // MS max delay

  // Automation & Presence
  welcomeMessage  String? @db.Text
  autoRead        Boolean @default(false)
  alwaysOnline    Boolean @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  session       Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

// Real-time forwarding of private conversations to e-mail (one config per session)
model EmailForward {
  id              String    @id @default(cuid())
  sessionId       String    @unique
  enabled         Boolean   @default(false)
  recipients      String    @db.Text // Comma-separated addresses
  includeOutgoing Boolean   @default(false) // Also forward messages sent by this number
  attachMedia     Boolean   @default(true)
  contextMessages Int       @default(5) // Previous messages of the chat included in each e-mail

  smtpHost        String
  smtpPort        Int       @default(587)
  smtpSecure      Boolean   @default(false) // true = implicit TLS (465); false = STARTTLS
  smtpUser        String?
  smtpPass        Json?     // EncryptedBlob (AES-256-GCM), never returned by the API
  fromAddress     String?

  sentCount       Int       @default(0)
  lastSentAt      DateTime?
  lastError       String?   @db.Text
  lastErrorAt     DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  session         Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model SystemConfig {
  id                 String   @id @default("default") // Singleton ID
  appName            String   @default("W-AZAP")
  logoUrl            String?
  faviconUrl         String?
  timezone           String   @default("America/Sao_Paulo")
  enableRegistration Boolean  @default(false)
  
  updatedAt          DateTime @updatedAt
}

// Labels/Tags for organizing chats
model Label {
  id          String      @id @default(cuid())
  sessionId   String
  name        String
  color       Int         @default(0) // 0-19 for WhatsApp color codes
  colorHex    String      @default("#FF0000") // Hex representation
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  chatLabels  ChatLabel[]
  
  @@unique([sessionId, name]) // Unique label name per session
  @@index([sessionId])
}

// Many-to-many relationship between chats and labels
model ChatLabel {
  id        String   @id @default(cuid())
  labelId   String
  chatJid   String   // The JID of the chat
  createdAt DateTime @default(now())
  
  label     Label    @relation(fields: [labelId], references: [id], onDelete: Cascade)
  
  @@unique([labelId, chatJid]) // Prevent duplicate label assignments
  @@index([chatJid])
  @@index([labelId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String   @db.Text
  type      String   @default("INFO") // INFO, WARNING, SUCCESS, SYSTEM
  read      Boolean  @default(false)
  href      String?
  
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Shared session access — allows session owners to grant access to other users
model SessionAccess {
  id        String   @id @default(cuid())
  sessionId String
  userId    String
  createdAt DateTime @default(now())

  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([userId])
  @@index([sessionId])
}

// Broadcast/Blast history & logs
model BroadcastLog {
  id          String              @id @default(cuid())
  sessionId   String              // WA session ID string
  message     String              @db.Text
  total       Int
  sent        Int                 @default(0)
  failed      Int                 @default(0)
  status      String              @default("running") // running, completed, cancelled
  delay       Int                 @default(2000)
  startedAt   DateTime            @default(now())
  completedAt DateTime?

  recipients  BroadcastRecipient[]

  @@index([sessionId])
  @@index([sessionId, startedAt])
}

model BroadcastRecipient {
  id              String       @id @default(cuid())
  broadcastLogId  String
  jid             String
  status          String       @default("pending") // pending, sent, failed
  error           String?      @db.Text
  sentAt          DateTime?

  broadcastLog    BroadcastLog @relation(fields: [broadcastLogId], references: [id], onDelete: Cascade)

  @@index([broadcastLogId])
}

// ── Smart scheduling (agenda): one business per WhatsApp session ──

enum AppointmentStatus {
  BOOKED     // Made by the customer or the panel
  CONFIRMED  // Customer answered the reminder
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum AppointmentSource {
  WHATSAPP
  PANEL
}

model AgendaConfig {
  id                 String   @id @default(cuid())
  sessionId          String   @unique
  enabled            Boolean  @default(false)
  businessName       String   @default("")
  businessInfo       String?  @db.Text // Address, payment methods, policies: shown to the customer and to the AI
  timezone           String   @default("America/Sao_Paulo")

  // Booking rules
  slotStep           Int      @default(15)  // Minutes between possible start times
  minAdvanceMinutes  Int      @default(60)  // Earliest booking, counted from now
  maxAdvanceDays     Int      @default(30)  // How far ahead customers can book
  cancelMinHours     Int      @default(2)   // Customers can't cancel/reschedule closer than this

  // When the assistant answers: ALL private chats, or only after the keyword
  triggerMode        String   @default("ALL") // ALL, KEYWORD
  triggerKeyword     String   @default("agendar")
  humanPauseHours    Int      @default(12)  // Assistant stays quiet in a chat after a person replies there

  // Reminders and notifications
  reminderEnabled    Boolean  @default(true)
  reminderHours      Int      @default(24)
  notifyProfessional Boolean  @default(true)

  // AI (any OpenAI-compatible chat completions API: OmniRoute, OpenAI, OpenRouter...)
  aiEnabled          Boolean  @default(false)
  aiBaseUrl          String?
  aiApiKey           Json?    // EncryptedBlob, never returned by the API
  aiModel            String?
  aiInstructions     String?  @db.Text
  aiLastError        String?  @db.Text
  aiLastErrorAt      DateTime?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  session            Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model AgendaService {
  id              String   @id @default(cuid())
  sessionId       String
  name            String
  description     String?  @db.Text
  durationMinutes Int
  priceCents      Int?
  active          Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  session         Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  professionals   AgendaProfessionalService[]
  appointments    AgendaAppointment[]

  @@index([sessionId])
}

model AgendaProfessional {
  id           String   @id @default(cuid())
  sessionId    String
  name         String
  phone        String?  // WhatsApp number that receives booking notices
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  session      Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  services     AgendaProfessionalService[]
  hours        AgendaWorkingHour[]
  blocks       AgendaBlock[]
  appointments AgendaAppointment[]

  @@index([sessionId])
}

model AgendaProfessionalService {
  professionalId String
  serviceId      String

  professional   AgendaProfessional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service        AgendaService      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([professionalId, serviceId])
  @@index([serviceId])
}

// Weekly working hours; several rows per weekday allow a lunch break
model AgendaWorkingHour {
  id             String   @id @default(cuid())
  professionalId String
  weekday        Int      // 0 = Sunday … 6 = Saturday
  startMinute    Int      // Minutes after midnight, business timezone
  endMinute      Int

  professional   AgendaProfessional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId, weekday])
}

// Days off, holidays, breaks. professionalId null = the whole business is closed
model AgendaBlock {
  id             String    @id @default(cuid())
  sessionId      String
  professionalId String?
  startsAt       DateTime
  endsAt         DateTime
  reason         String?
  createdAt      DateTime  @default(now())

  session        Session             @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  professional   AgendaProfessional? @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([sessionId, startsAt])
}

model AgendaAppointment {
  id             String            @id @default(cuid())
  sessionId      String
  professionalId String
  serviceId      String
  customerJid    String            // Phone JID (…@s.whatsapp.net) when known
  customerName   String?
  startsAt       DateTime
  endsAt         DateTime
  status         AppointmentStatus @default(BOOKED)
  source         AppointmentSource @default(WHATSAPP)
  notes          String?           @db.Text
  priceCents     Int?              // Price at booking time
  reminderSentAt DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  session        Session            @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  professional   AgendaProfessional @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  service        AgendaService      @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([sessionId, startsAt])
  @@index([professionalId, startsAt])
  @@index([sessionId, customerJid])
}

// Per-chat state of the WhatsApp assistant (menu step, AI history, human takeover)
model AgendaConversation {
  id          String    @id @default(cuid())
  sessionId   String
  jid         String
  state       Json?     // Menu flow position and choices
  history     Json?     // Recent AI messages
  pausedUntil DateTime? // A person answered: the assistant stays quiet until then
  updatedAt   DateTime  @updatedAt

  session     Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, jid])
}
