{
  "name": "w-azap",
  "version": "2.5.0",
  "description": "Gateway e painel de WhatsApp com várias sessões, API REST, webhooks e automação (Next.js + Baileys).",
  "author": "marloon-dev",
  "homepage": "https://github.com/marloon-dev/w-azap#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marloon-dev/w-azap.git"
  },
  "bugs": {
    "url": "https://github.com/marloon-dev/w-azap/issues"
  },
  "keywords": [
    "whatsapp",
    "whatsapp-api",
    "whatsapp-gateway",
    "whatsapp-bot",
    "baileys",
    "nextjs",
    "rest-api",
    "webhooks"
  ],
  "engines": {
    "node": ">=20.9.0"
