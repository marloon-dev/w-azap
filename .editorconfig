root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
# Indent width varies across legacy files (2 or 4 spaces): keep each file's existing width

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.patch]
trim_trailing_whitespace = false
insert_final_newline = false
